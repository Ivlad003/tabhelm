# TabHelm host + CLI agents in a container, serving a panel through a TabHelm
# relay (relay/README.md). Build from the repository root:
#   docker build -f host/Dockerfile.agent -t tabhelm-agent .
# Run (or deploy on Dokploy as an application with these environment variables):
#   docker run -e TABHELM_RELAY_URL=wss://relay.example.com -e TABHELM_RELAY_KEY=... \
#              -e OPENROUTER_API_KEY=... -v tabhelm-data:/home/node/.tabhelm tabhelm-agent
# The pairing code is printed in the container log on first start.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates ffmpeg && rm -rf /var/lib/apt/lists/*
# Agents: OpenCode (any provider via API keys) and Claude Code (ANTHROPIC_API_KEY).
RUN npm install -g --no-audit --no-fund opencode-ai @anthropic-ai/claude-code
WORKDIR /app/host
COPY host/package.json host/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY host/ ./
COPY extension/manifest.json /app/extension/manifest.json
RUN chown -R node:node /app
USER node
ENV HOME=/home/node
VOLUME ["/home/node/.tabhelm"]
# Host, memory, skills cache and the relay token live in /home/node/.tabhelm.
CMD ["node", "src/native-host.js", "--relay"]
