{
  "manifest_version": 3,
  "name": "TabHelm",
  "version": "0.22.0",
  "description": "Side-panel chat that lets terminal coding agents (Claude Code, Codex, Cursor, Antigravity, OpenCode, Qoder, Grok) or OpenRouter/Ollama models operate the current tab.",
  "key": "",
  "permissions": [
    "sidePanel",
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs",
    "storage",
    "webNavigation",
    "unlimitedStorage",
    "tabGroups",
    "alarms",
    "notifications",
    "tabCapture",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open TabHelm for this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "add-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Add the selected text on the page to the TabHelm chat"
    }
  }
}
